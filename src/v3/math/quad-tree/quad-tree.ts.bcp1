// https://github.com/timohausmann/quadtree-js/blob/master/quadtree.js

export interface QuadTreeBox {
  readonly x: number;
  readonly y: number;
  readonly width: number;
  readonly height: number;
}

export type QuadTreeItem = QuadTreeBox;

export class QuadTree<GItem extends QuadTreeItem> implements QuadTreeBox {
  readonly #items: GItem[] = [];

  #child00: QuadTree<GItem> | undefined;
  #child01: QuadTree<GItem> | undefined;
  #child10: QuadTree<GItem> | undefined;
  #child11: QuadTree<GItem> | undefined;

  constructor() {
    // this.#child00 = undefined;
  }

  get items(): readonly GItem[] {
    return this.#items;
  }

  insert(item: GItem): void {}
}
